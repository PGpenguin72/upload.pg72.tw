UPLOAD_DIR=./uploads
TEMP_DIR=./temp
MAX_FILE_SIZE_BYTES=5368709120
MAX_CHUNK_SIZE_BYTES=10485760

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=your@email.com
FROM_EMAIL=upload@pg72.tw

BASE_URL=https://upload.pg72.tw
OIDC_ISSUER=https://sso.pg72.tw
OIDC_CLIENT_ID=pg72-upload
OIDC_CLIENT_SECRET=pg72_cs_replace-with-client-secret
# PG72 ID 的 immutable user sub (UUID)，不是 Email
OIDC_BOOTSTRAP_ADMIN_SUB=00000000-0000-4000-8000-000000000000
OIDC_ADMIN_REQUIRED_ROLE=admin
# 產生方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
ADMIN_SESSION_TTL_SECONDS=900
ADMIN_OAUTH_TRANSACTION_TTL_SECONDS=600
ADMIN_COOKIE_NAME=pg72_upload_admin

PORT=3000
